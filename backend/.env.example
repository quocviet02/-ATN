PORT=3000

MONGODB_URI=mongodb://localhost:27017/task_manager

ACCESS_TOKEN_SECRET=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=change_this_to_another_long_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Email (nodemailer / Gmail) ───────────────────────────────────────────────
# Để gửi email thật: bật 2FA trên Gmail → tạo App Password → điền vào đây
# Nếu để trống hoặc giữ giá trị mặc định → link mời sẽ được log ra console
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_gmail@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM="Project Manager <your_gmail@gmail.com>"
CLIENT_URL=http://localhost:4200

PORT=3000

MONGODB_URI=mongodb://localhost:27017/task_manager

ACCESS_TOKEN_SECRET=change_this_to_a_long_random_string
ACCESS_TOKEN_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=change_this_to_another_long_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Email (Resend API) ───────────────────────────────────────────────────────
# Đăng ký free tại https://resend.com → lấy API key tại https://resend.com/api-keys
# Nếu để trống → link mời sẽ được log ra console thay vì gửi thật
RESEND_API_KEY=your_resend_api_key
# Sandbox onboarding@resend.dev chỉ gửi được tới email bạn dùng đăng ký Resend.
# Để gửi tới user thật, verify domain riêng tại https://resend.com/domains
MAIL_FROM="Project Manager <onboarding@resend.dev>"
CLIENT_URL=http://localhost:4200
